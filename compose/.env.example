# One file decides everything. Copy it to .env and edit:
#
#   cp compose/.env.example compose/.env
#
# Nothing here is a secret you must keep out of git except the values below marked SECRET:
# compose/.env is gitignored precisely because of them.

# ---------------------------------------------------------------- postgres (REQUIRED)
# The database Hindsight keeps its bank in. Compose refuses to start without it rather than
# inventing a default: a memory that everybody's default password can open is not a memory.
# SECRET. Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- the provider axis
# The part that makes "any model" true. These four values are handed to Hindsight as-is and
# to DSH as an OpenAI-compatible route, so the stack cannot end up with two opinions.
#
# Hindsight accepts:  openai | openai-responses | anthropic | gemini | groq | deepseek |
#                     ollama | ollama-cloud | lmstudio | llamacpp | bedrock | litellm |
#                     openrouter | requesty | none
# `none` is legitimate: retrieval, the knowledge base and the tooling all work without a
# model. Only ingest and new-memory extraction need one.
LLM_PROVIDER=ollama-cloud
# Leave empty for a provider that knows its own endpoint (ollama-cloud, openai, cohere).
# Set it for a gateway, a local daemon (http://host.docker.internal:11434/v1) or anything
# OpenAI-compatible.
LLM_BASE_URL=
LLM_MODEL=gpt-oss:120b
# SECRET (only for hosted providers; a local server needs none).
LLM_API_KEY=

# Embeddings: the one thing Ollama Cloud cannot serve. Hindsight's embedding providers are
# local | onnx | openai | openai-codex | openrouter | cohere | google | tei | zeroentropy |
# litellm, and there is no `ollama` among them; measured, https://ollama.com/v1/embeddings
# answers 404 while the native /api/embed answers 401, so it is not an OpenAI-compatible
# embedding endpoint either. Two ways out, both supported:
#
#   EMBEDDINGS_PROVIDER=tei    a small self-hosted container (compose profile `tei`); no key,
#                              no chat model locally, production-quality embeddings
#   EMBEDDINGS_PROVIDER=openai a cloud key instead: openai | cohere | google | zeroentropy
#
# Changing this later is recoverable but not free: dimensions are fixed once a bank holds
# memories, and moving requires an export and a re-import (the import re-embeds).
# Default `onnx`: in-process, CPU, no extra service and no chat model. The model below is
# the one the seeded bank was embedded with, and its 384 dimensions are not a detail --
# matching them means an existing bank can be re-imported without rebuilding it.
EMBEDDINGS_PROVIDER=onnx
EMBEDDINGS_ONNX_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDINGS_ONNX_DIMENSIONS=384
# Or a self-hosted service:  docker compose --profile tei up -d
#   EMBEDDINGS_PROVIDER=tei   EMBEDDINGS_TEI_URL=http://tei:80
# Or somebody else's cloud embeddings (openai | cohere | google | zeroentropy), with a key.
EMBEDDINGS_TEI_URL=http://tei:80
EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small
EMBEDDINGS_LOCAL_MODEL=intfloat/multilingual-e5-small
EMBEDDINGS_LOCAL_FORCE_CPU=true
# Used only when EMBEDDINGS_PROVIDER=openai-ish. SECRET when hosted.
EMBEDDINGS_API_KEY=

# ---------------------------------------------------------------- Sedna ingest
# Adding knowledge to the base is the only Sedna stage that calls a model. The URL decides
# how it is called: anything containing `ollama.com` or `/v1` is treated as
# OpenAI-compatible, everything else as a native Ollama endpoint.
# A local daemon is the cheap path; note that a hosted model may ignore a JSON schema, which
# is why the ingest validates what it gets back (docs/adding-knowledge.md).
SEDNA_OLLAMA_URL=https://ollama.com/v1
SEDNA_OLLAMA_MODEL=gpt-oss:120b
# SECRET, when hosted.
SEDNA_OLLAMA_API_KEY=

# The DSH agent's own model, if you run it against DeepSeek's official endpoint instead of
# the OpenAI-compatible route above. SECRET.
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------- ports and paths
# Bound to 127.0.0.1 in docker-compose.yml on purpose. Read compose/README.md before
# exposing either of these beyond this machine.
HINDSIGHT_PORT=9177
DSH_PORT=3080
# Where the seed artifacts live, and what the agent gets as a workspace.
SEED_DIR=../seed
WORKSPACE_DIR=..

# ---------------------------------------------------------------- off-machine backup (NOT IMPLEMENTED YET)
# The bank grows without bound and does not belong in git. The design slot is here so it can
# be filled without touching the compose file; docs/ROADMAP.md tracks the work. An
# S3-compatible endpoint is the target shape because R2, B2 and MinIO all present it.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_PREFIX=sedna-stack
